# Backend: process environment wins; root .env is also read by Compose.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=sqlite:///./opsguard.db
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Reasoning defaults to the credential-free deterministic provider.
LLM_PROVIDER=deterministic
# OpenAI mode is opt-in: set LLM_PROVIDER=openai and provide both fields backend-side.
OPENAI_API_KEY=
OPENAI_MODEL=
# Claude: select LLM_PROVIDER=anthropic and an available structured-output model.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# Native API root; the adapter appends /v1/messages, preserving any proxy prefix.
ANTHROPIC_BASE_URL=https://api.anthropic.com
# Optional timeout override, otherwise LLM_TIMEOUT_SECONDS applies.
# ANTHROPIC_TIMEOUT_SECONDS=60

# Ollama: select LLM_PROVIDER=ollama and a chat model you have installed.
OLLAMA_MODEL=
# Native API root; the adapter appends /api/chat. Remote endpoints require HTTPS.
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional bearer token for an authenticated HTTPS reverse proxy; blank for local Ollama.
OLLAMA_API_KEY=
# OLLAMA_TIMEOUT_SECONDS=60
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1800
# Compose's local PostgreSQL credentials (not application settings).
POSTGRES_USER=opsguard
POSTGRES_PASSWORD=opsguard
POSTGRES_DB=opsguard_ai
# Public browser API URL: embedded at BUILD TIME, never put secrets here.
# Native Next.js reads process environment or frontend/.env.local, not root .env.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
